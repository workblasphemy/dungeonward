extends RefCounted
## M1-IP-02 pure gesture regression tests. Window below is a test fixture, not game tuning.
const WINDOW := 5000

static func run(check: Callable, gesture_script: Script) -> void:
    var g: Variant = gesture_script.new()
    var a: Dictionary = g.start_pressed(0, 100, WINDOW)
    check.call(a["state"] == g.STATE_CONFIRMING and a["intent"] == g.INTENT_NONE, "first Start only prompts")
    var b: Dictionary = g.start_pressed(1, 101, WINDOW)
    check.call(b["state"] == g.STATE_CONFIRMING, "other device has independent prompt")
    check.call(g.get_device_state(0) == g.STATE_CONFIRMING, "other device cannot confirm device zero")
    var c: Dictionary = g.start_pressed(0, 200, WINDOW)
    check.call(c["state"] == g.STATE_RESERVING and c["intent"] == g.INTENT_REQUEST_RESERVATION, "same-device second Start requests reservation")
    check.call(g.start_pressed(0, 201, WINDOW)["intent"] == g.INTENT_NONE, "pending request not duplicated")
    check.call(g.start_pressed(1, 202, WINDOW)["intent"] == g.INTENT_REQUEST_RESERVATION, "simultaneous devices confirm independently")
    check.call(g.mark_assigned(2, true)["error_code"] == "ASSIGNMENT_NOT_APPROVED", "unassigned device cannot be marked assigned")
    check.call(g.start_pressed(3, 100, WINDOW, true)["error_code"] == "ASSIGNMENT_MISMATCH", "external assigned flag cannot bypass approval")
    check.call(g.reservation_result(0, true)["state"] == g.STATE_SELECTING, "host approval enters character selection")
    check.call(g.mark_assigned(0)["error_code"] == "ASSIGNMENT_NOT_APPROVED", "binding confirmation required")
    check.call(g.mark_assigned(0, true)["state"] == g.STATE_ASSIGNED, "explicit approved binding marks assigned")
    check.call(g.start_pressed(0, 300, WINDOW, true)["intent"] == g.INTENT_OPEN_MENU, "assigned Start opens menu")
    check.call(g.start_pressed(0, 300, WINDOW, false)["error_code"] == "ASSIGNMENT_MISMATCH", "assigned state cannot silently lose binding")
    check.call(g.cancel(0)["error_code"] == "CANNOT_CANCEL_ASSIGNED", "assigned cannot be cancelled")
    check.call(g.disconnect_device(0)["state"] == g.STATE_ASSIGNED, "assigned disconnect retains slot ownership")
    check.call(g.unbind_device(0)["error_code"] == "UNBIND_NOT_CONFIRMED", "unbind requires registry confirmation")
    check.call(g.unbind_device(0, true)["state"] == g.STATE_UNASSIGNED, "confirmed unbind clears gesture state")
    check.call(g.cancel(1)["intent"] == g.INTENT_RELEASE_RESERVATION, "inflight cancellation requests host cleanup")
    check.call(g.reservation_result(1, true)["error_code"] == "INVALID_STATE", "late success cannot silently select")
    var selecting: Variant = gesture_script.new()
    selecting.start_pressed(4, 100, WINDOW)
    selecting.start_pressed(4, 200, WINDOW)
    selecting.reservation_result(4, true)
    check.call(selecting.cancel(4)["intent"] == selecting.INTENT_RELEASE_RESERVATION, "selection cancellation requests host release")
    var failed: Variant = gesture_script.new()
    failed.start_pressed(5, 100, WINDOW)
    failed.start_pressed(5, 200, WINDOW)
    check.call(failed.reservation_result(5, false, "LOBBY_FULL")["error_code"] == "LOBBY_FULL", "capacity rejection passed through")
    check.call(failed.get_device_state(5) == failed.STATE_UNASSIGNED, "failed reservation resets gesture")
    var timed: Variant = gesture_script.new()
    timed.start_pressed(6, 100, WINDOW)
    check.call(timed.start_pressed(6, 100 + WINDOW, WINDOW)["intent"] == timed.INTENT_REQUEST_RESERVATION, "deadline inclusive")
    timed.start_pressed(7, 100, WINDOW)
    check.call(timed.start_pressed(7, 101 + WINDOW, WINDOW)["state"] == timed.STATE_CONFIRMING, "expired second press restarts prompt")
    timed.start_pressed(8, 100, WINDOW)
    check.call(timed.expire(101 + WINDOW)["expired_devices"].has(8), "explicit expiry clears idle prompt")
    check.call(timed.start_pressed(9, -1, WINDOW)["error_code"] == "INVALID_TIMESTAMP", "invalid timestamp rejected")
    check.call(timed.start_pressed(9, 0, 0)["error_code"] == "INVALID_WINDOW", "invalid window rejected")
    check.call(timed.start_pressed(-1, 0, WINDOW)["error_code"] == "INVALID_ID", "invalid device rejected")
    var solo: Variant = gesture_script.new()
    check.call(solo.get_device_state(0) == solo.STATE_UNASSIGNED, "join gesture does not require any additional players to start solo")
    check.call(solo.start_pressed(0, 100, WINDOW)["intent"] == solo.INTENT_NONE, "no implicit spawn or world start")
