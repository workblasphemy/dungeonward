extends RefCounted
## Independent M1-IP-03A regressions. Fixture actions are not approved game mappings.
static func run(check: Callable, router_script: Script, registry_script: Script) -> bool:
    var registry: RefCounted = registry_script.new()
    check.call(registry.bind_device(1, 0)["ok"], "router fixture binds device 1")
    check.call(registry.bind_device(2, 1)["ok"], "router fixture binds device 2")
    var original: Array[Dictionary] = registry.assignments()
    var router: RefCounted = router_script.new(registry, ["fixture_jump", "fixture_menu"])
    check.call(router is RefCounted, "router is pure RefCounted")
    var a: Dictionary = router.route_action(1, "fixture_jump", true, 3)
    check.call(a["ok"] and a["event"]["local_slot_id"] == 0, "device 1 routes to slot 0")
    check.call(a["event"]["device_id"] == 1 and a["event"]["pressed"], "event preserves source and pressed state")
    var b: Dictionary = router.route_action(2, "fixture_menu", false, 1)
    check.call(b["ok"] and b["event"]["local_slot_id"] == 1, "device 2 routes to slot 1")
    check.call(b["event"]["sequence"] == 1 and not b["event"]["pressed"], "second device retains sequence and release")
    check.call(router.route_action(1, "fixture_jump", true, 3)["error_code"] == "STALE_OR_DUPLICATE_SEQUENCE", "duplicate rejected")
    check.call(router.route_action(1, "fixture_jump", true, 2)["error_code"] == "STALE_OR_DUPLICATE_SEQUENCE", "older sequence rejected")
    check.call(router.route_action(1, "fixture_jump", true, 4)["ok"], "valid newer sequence accepted")
    check.call(router.route_action(99, "fixture_jump", true, 0)["error_code"] == "NOT_FOUND", "unbound device rejected")
    check.call(router.route_action(-1, "fixture_jump", true, 0)["error_code"] == "INVALID_ID", "negative ID rejected")
    check.call(router.route_action(2, "fixture_menu", true, -1)["error_code"] == "INVALID_SEQUENCE", "negative sequence rejected")
    check.call(router.route_action(2, "", true, 2)["error_code"] == "EMPTY_ACTION", "empty action rejected")
    check.call(router.route_action(2, "forged_action", true, 2)["error_code"] == "ACTION_NOT_ALLOWED", "allowlist blocks arbitrary action")
    check.call(router.route_action(2, "fixture_menu", true, 2)["ok"], "rejected actions did not consume sequence")
    check.call(router.route_action(1, "fixture_jump", true, 5)["ok"], "device 2 rejections cannot affect device 1")
    check.call(registry.disconnect_device(1)["ok"], "registry disconnect succeeds")
    check.call(router.route_action(1, "fixture_jump", true, 6)["error_code"] == "DEVICE_DISCONNECTED", "disconnected input rejected")
    check.call(router.route_action(3, "fixture_jump", true, 0)["error_code"] == "NOT_FOUND", "new device cannot steal disconnected slot")
    check.call(registry.bind_device(3, 0)["error_code"] == "SLOT_OCCUPIED", "disconnect preserves slot ownership")
    check.call(registry.reconnect_device(1)["ok"], "registry reconnect succeeds")
    check.call(router.route_action(1, "fixture_jump", true, 6)["ok"], "disconnect rejection did not consume sequence")
    check.call(router.route_action(2, "fixture_menu", true, 1)["error_code"] == "STALE_OR_DUPLICATE_SEQUENCE", "new stream cannot replay before reset")
    check.call(router.reset_device_sequence(2)["ok"], "trusted reset succeeds")
    check.call(router.route_action(2, "fixture_menu", true, 1)["ok"], "reset allows restarted stream")
    check.call(router.reset_device_sequence(-1)["error_code"] == "INVALID_ID", "invalid reset rejected")
    check.call(registry.unbind_device(1)["ok"], "explicit unbind succeeds")
    check.call(router.route_action(1, "fixture_jump", true, 7)["error_code"] == "NOT_FOUND", "unbound device input rejected")
    check.call(registry.bind_device(1, 0)["ok"], "device rebind succeeds")
    check.call(router.route_action(1, "fixture_jump", true, 0)["error_code"] == "STALE_OR_DUPLICATE_SEQUENCE", "rebind does not silently reset sequence")
    check.call(router.reset_device_sequence(1)["ok"], "explicit rebind stream reset")
    check.call(router.route_action(1, "fixture_jump", true, 0)["ok"], "new stream works after reset")
    check.call(registry.assignments() == original, "router does not mutate device ownership")
    var rejected: Dictionary = router.route_action(99, "fixture_jump", true, 0)
    check.call(rejected["event"].is_empty(), "rejected event is empty")
    var invalid: RefCounted = router_script.new(registry, ["fixture_jump", ""])
    check.call(invalid.route_action(1, "fixture_jump", true, 0)["error_code"] == "ACTION_NOT_ALLOWED", "invalid constructor allowlist fails closed")
    check.call(invalid.set_allowed_actions(["fixture_jump"])["ok"], "valid configuration can recover")
    check.call(invalid.route_action(1, "fixture_jump", true, 0)["ok"], "valid allowlist routes")
    return true
